generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  country     String?
  logo        String?
  vehicles    Vehicle[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vehicle {
  id               String     @id @default(cuid())
  brandId          String
  brand            Brand      @relation(fields: [brandId], references: [id])
  name             String
  slug             String
  bodyType         String
  price            Float
  oldPrice         Float?
  engine           String?
  transmission     String?
  fuelType         String?
  fuelEconomy      String?
  seats            Int?
  description      String?
  image            String?
  images           String     @default("[]")
  isPopular        Boolean    @default(false)
  isAvailable      Boolean    @default(true)
  launchYear       Int?
  horsepower       Int?
  torque           String?
  groundClearance  String?
  bootSpace        String?
  length           String?
  width            String?
  height           String?
  wheelbase        String?
  fuelTankCapacity String?
  kerbWeight       String?
  features         String     @default("[]")
  pros             String     @default("[]")
  cons             String     @default("[]")
  reviews          Review[]
  groupChat        GroupChat?
  averageRating    Float      @default(0)
  totalReviews     Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([brandId, name])
  @@index([bodyType])
  @@index([price])
  @@index([isPopular])
}

model Review {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userName   String
  email      String
  rating     Int
  title      String?
  review     String
  pros       String?
  cons       String?
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([vehicleId, email])
  @@index([vehicleId])
  @@index([rating])
}

model Guide {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String?
  image     String?
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MashwaraRequest {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  budgetMin     Float?
  budgetMax     Float?
  bodyType      String?
  familySize    String?
  message       String?
  paymentStatus String   @default("pending") // pending, paid, verified, rejected
  transactionId String?
  screenshot    String? // NEW: Payment screenshot
  adminNote     String? // NEW: Admin notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GroupChat {
  id           String            @id @default(cuid())
  vehicleId    String            @unique
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  participants ChatParticipant[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ChatMessage {
  id        String    @id @default(cuid())
  chatId    String
  chat      GroupChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userName  String
  userEmail String?
  message   String
  image     String?
  isPinned  Boolean   @default(false)
  isAdmin   Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model ChatParticipant {
  id        String    @id @default(cuid())
  chatId    String
  chat      GroupChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userName  String
  userEmail String?
  joinedAt  DateTime  @default(now())
}
